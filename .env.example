# ============================================================
# OH I SEE — Environment Variables (copy to .env for local use)
# NEVER commit real secrets. Use K8s Secrets in production.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development

# Backend API port (container listens on 3001)
PORT=3001

# Public URLs (CORS, redirects, email links)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
PLATFORM_DOMAIN=ohisee.com

# ── Frontend runtime (Docker/K8s inject into runtime-config.js) ──
# Browser-safe only — never put service role key here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Empty = same-origin /api (docker-compose nginx proxy)
OHISEE_API_BASE=

# ── Auth (server only) ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Supabase (server only) ──────────────────────────────────
# ANON_KEY is required on the backend for password login verification
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI (server only) ────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-4.1-mini
IMAGE_GENERATION_API_KEY=

# ── Design3D worker (optional profile) ──────────────────────
DESIGN3D_WORKER_MODE=bridge
BLENDER_BRIDGE_URL=http://127.0.0.1:8766
BLENDER_EXECUTABLE=
DESIGN3D_STORAGE=local
DESIGN3D_STORAGE_ROOT=/app/.data/design3d
DESIGN3D_BUCKET=design3d-private
DESIGN3D_JOB_TIMEOUT_MS=3600000
DESIGN3D_WIDTH=1600
DESIGN3D_HEIGHT=1100
DESIGN3D_SAMPLES=64

# ── Payments (server only) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (server only) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ohisee.com

# ── Misc ────────────────────────────────────────────────────
SEED_DEMO_DATA=false
CONSTRUCTION_AUTO_VERIFY=false

# ── Docker image tags (CI/CD) ───────────────────────────────
OHISEE_API_IMAGE=ohisee-api:local
OHISEE_FRONTEND_IMAGE=ohisee-frontend:local
OHISEE_WORKER_IMAGE=ohisee-design3d-worker:local
